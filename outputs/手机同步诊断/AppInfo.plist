<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.local.focusquest.calendarprobe</string>
  <key>CFBundleExecutable</key><string>CalendarProbeApp</string>
  <key>CFBundleName</key><string>专注日历诊断</string>
  <key>CFBundleDisplayName</key><string>专注日历诊断</string>
  <key>CFBundlePackageType</key><string>APPL</string>
